# Copy to `.env` or set in your shell. All variables are optional unless noted.
# These are read at runtime via `process.env.*` — opencode does not auto-load .env
# files. Use direnv, dotenvx, or shell exports to make them available.
#
# All default URLs live in packages/core/src/config/endpoints.ts. The CLI wires
# env reads in packages/opencode/src/config/endpoints.ts.

# Optional override for the Base → Soma bridge paymaster URL.
# Defaults to `${SOMACODE_ONRAMP_BASE_URL}/api/paymaster` — the somacode backend
# proxies CDP after JWT auth (intent_token minted at /api/auth/register), so
# no direct CDP URL is required for the standard flow. Set this only to bypass
# the backend and hit CDP directly during debugging. When set, allowlist
# USDC.approve and SomaBridge.deposit in your CDP paymaster policy.
# BASE_PAYMASTER_URL=

# Optional separate bundler RPC. Defaults to BASE_PAYMASTER_URL (CDP serves
# bundler + paymaster at the same endpoint, and the backend proxy mirrors
# that). Override only if your paymaster and bundler are split.
# BASE_BUNDLER_URL=

# Optional Base Sepolia RPC URL used for nonce/gas reads. Defaults to
# https://sepolia.base.org. Replace with Alchemy/QuickNode/Infura for production.
# BASE_SEPOLIA_RPC_URL=

# Optional Soma GraphQL endpoint overrides. Default for all three is
# https://graphql.testnet.soma.org/graphql. Override individually to point
# specific consumers at different endpoints (e.g. mainnet for models).
# SOMACODE_INDEXER_GRAPHQL_URL=  # soma proxy / indexer / trusted-server
# SOMACODE_BALANCE_GRAPHQL_URL=  # TUI balance fetcher fallback
# SOMACODE_MODELS_GRAPHQL_URL=   # model picker fallback

# Optional onramp event stream base URL (Stripe checkout backend SSE).
# Defaults to http://95.217.102.55:3010.
# SOMACODE_ONRAMP_BASE_URL=

# Optional payment gateway URL used by the buy-usdc dialog. Defaults to
# http://localhost:8000. The VITE_-prefixed variant takes precedence so the
# same value works in the web app via import.meta.env.
# VITE_SOMACODE_PAYMENT_GATEWAY_URL=
# SOMACODE_PAYMENT_GATEWAY_URL=

# Optional `sup` installer URL used on first run to bootstrap the soma binary.
# Defaults to https://sup.soma.org.
# SUP_INSTALLER_URL=
