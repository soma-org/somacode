# Copy to `.env` or set in your shell. All variables are optional unless noted.
# These are read at runtime via `process.env.*` — opencode does not auto-load .env
# files. Use direnv, dotenvx, or shell exports to make them available.

# Base → Soma bridge — Coinbase Developer Platform paymaster URL.
# Required for the "To Soma USDC" step. Allowlist USDC.approve and SomaBridge.deposit
# in the paymaster policy. See bridge.md for details.
# BASE_PAYMASTER_URL=

# Optional separate bundler RPC. Defaults to BASE_PAYMASTER_URL (CDP serves both
# at the same endpoint). Override only if your paymaster and bundler are split.
# BASE_BUNDLER_URL=

# Optional Base Sepolia RPC URL used for nonce/gas reads. Defaults to
# https://sepolia.base.org. Replace with Alchemy/QuickNode/Infura for production.
# BASE_SEPOLIA_RPC_URL=

# Optional GraphQL endpoint overrides. Default is https://graphql.testnet.soma.org/graphql.
# SOMACODE_BALANCE_GRAPHQL_URL=
# SOMACODE_MODELS_GRAPHQL_URL=

# Optional onramp event stream base URL (Stripe checkout backend SSE).
# SOMACODE_ONRAMP_BASE_URL=

# Optional payment gateway URL used by the buy-usdc dialog.
# VITE_SOMACODE_PAYMENT_GATEWAY_URL=
