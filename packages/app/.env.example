# Copy to `.env` and fill in values. All variables are optional unless noted.

# OpenCode server (defaults: localhost:4096)
# VITE_OPENCODE_SERVER_HOST=localhost
# VITE_OPENCODE_SERVER_PORT=4096
# VITE_OPENCODE_CHANNEL=dev

# Buy USDC — Stripe crypto onramp session (POST + Bearer auth)
VITE_USDC_CHECKOUT_URL=https://api.stripe.com/v1/crypto/onramp_sessions
VITE_STRIPE_TEST_KEY=sk_test_your_stripe_secret_key

# Onramp backend SSE (GET /api/events). Defaults to built-in host if unset.
VITE_ONRAMP_BASE_URL=http://localhost:3010

# Payment gateway checkout page (`?wallet=0x…` appended). Defaults to http://localhost:8000 if unset.
VITE_PAYMENT_GATEWAY_URL=http://localhost:8000

# Optional GraphQL
# VITE_MODELS_GRAPHQL_URL=
# VITE_BALANCE_GRAPHQL_URL=

# Optional Sentry (client)
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=

# Optional Sentry (source maps at build time; not exposed to the client)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
